{
  "name": "disklens",
  "version": "2.1.0",
  "description": "DiskLens —— 给电脑小白的磁盘空间可视化工具：块越大 = 占地方越多，一眼看懂，安全清理",
  "main": "./out/main/index.js",
  "author": "DiskLens Contributors",
  "license": "MIT",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "e2e": "node scripts/e2e.mjs",
    "e2e:full": "npm run build && node scripts/e2e.mjs",
    "e2e:packaged": "node scripts/e2e-packaged.mjs",
    "audit": "node scripts/audit.mjs",
    "postinstall": "install-electron && electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:linux": "electron-vite build && electron-builder --linux"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "echarts": "^6.1.0",
    "lucide": "^1.59.0",
    "morphicons": "^2.0.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.1",
    "@electron-toolkit/eslint-config-ts": "^4.0.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "playwright-core": "^1.64.1",
    "prettier": "^3.9.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  }
}
